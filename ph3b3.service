[Unit]
Description=Ph3b3 AI Assistant Server
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
# Replace "youruser" and the two paths below with your account and clone
# location. systemd does not expand variables in User=/WorkingDirectory=/
# EnvironmentFile=, so these must be literal. ExecStart uses ${PH3B3_HOME},
# which is loaded from the EnvironmentFile — set PH3B3_HOME in your .env.
User=youruser
WorkingDirectory=/home/youruser/ph3b3_v2
EnvironmentFile=/home/youruser/ph3b3_v2/.env
ExecStart=${PH3B3_HOME}/.venv/bin/python agent/server.py
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ph3b3

[Install]
WantedBy=multi-user.target
