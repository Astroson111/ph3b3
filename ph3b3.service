[Unit]
Description=Ph3b3 AI Assistant Server
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=astroson
WorkingDirectory=/home/astroson/Desktop/ph3b3_v2
EnvironmentFile=/home/astroson/Desktop/ph3b3_v2/.env
# piper (TTS) and aplay live outside systemd's minimal default PATH — pipx puts
# piper in ~/.local/bin and pip puts it in the venv. Without this the server
# starts but TTS silently fails with "piper: command not found".
Environment=PATH=/home/astroson/Desktop/ph3b3_v2/.venv/bin:/home/astroson/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/astroson/Desktop/ph3b3_v2/.venv/bin/python agent/server.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ph3b3

[Install]
WantedBy=multi-user.target
