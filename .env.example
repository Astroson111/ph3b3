# Ph3b3 environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Web UI auth ──────────────────────────────────────────────────────────────
# Username and password for HTTP basic auth on the web UI.
# Leave PH3B3_PASSWORD blank to disable auth (not recommended on a networked machine).
PH3B3_USER=your_username
PH3B3_PASSWORD=your_password_here

# ── Paths ────────────────────────────────────────────────────────────────────
# PH3B3_HOME is the repo root. The Python code derives it automatically from its
# own location, so you normally do NOT need to set it here — EXCEPT that the
# systemd unit's ExecStart references ${PH3B3_HOME}. Set it to your clone path
# if you run Ph3b3 via ph3b3.service.
# PH3B3_HOME=/home/youruser/ph3b3_v2
#
# PH3B3_DATA is the runtime data root (recipes.db, memory.json, voices, photos…).
# Defaults to ~/ph3b3_data. Uncomment to relocate.
# PH3B3_DATA=/home/youruser/ph3b3_data

# ── Server ───────────────────────────────────────────────────────────────────
PH3B3_HOST=0.0.0.0
PH3B3_PORT=7331

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
PH3B3_MODEL=hermes3

# ── Vision ───────────────────────────────────────────────────────────────────
# Model used for camera/image analysis. Must be a multimodal model in Ollama:
#   ollama pull minicpm-v
# Changing this moves BOTH surfaces — the camera (vision_module) and screenshot
# reading (screenshot_module). No code edit; change the line and restart.
#
# 2026-08-31: llava -> minicpm-v. On a real captured frame llava reported a
# gaming setup that was not in shot and "another person's arm" that was the
# user's own — the same invention behind the hallucinated-sight incident. It
# kept doing it after the prompt was rewritten to demand hedging, so it is the
# model, not the prompt. minicpm-v names only what is there (and reads text in
# frame). Pick on RUNTIME footprint, not download size: qwen2.5vl:7b describes
# better still but allocates ~14 GB whatever num_ctx says, spills to CPU and
# starves ComfyUI; minicpm-v runs in ~4.7 GB fully on GPU, warm latency within
# noise of llava. On a 16 GB card shared with ComfyUI, that is the constraint.
#
# If you swap this, keep the prompts in modules/vision_module.py free of persona
# framing ("You are Ph3b3, looking at...") — that made minicpm-v answer as a
# character and ask a question back on 1 run in 5. Plain instruction: 0 in 5.
PH3B3_VISION_MODEL=minicpm-v:latest

# ── Speech ───────────────────────────────────────────────────────────────────
# Full path to a Piper .onnx voice model file.
# Default: ~/ph3b3_data/voices/en_GB-alba-medium.onnx
# PH3B3_VOICE_MODEL=/home/youruser/ph3b3_data/voices/en_GB-alba-medium.onnx

# Stable substring of the USB speaker's PipeWire sink name for TTS routing.
# Run `pactl list short sinks` with the speaker connected and copy a unique
# substring of the sink name (second column) — e.g. "usb-Focusrite" or
# "usb-C-Media_Electronics".  Resolved per-utterance; plug/unplug works live.
# Leave empty (or unset) to play to the PipeWire default sink.
# PH3B3_SPEAKER_SINK=usb-

# Whisper model size: tiny, base, small, medium, large
# Larger = more accurate, slower, more VRAM.
PH3B3_WHISPER_MODEL=medium

# ── Spotify ───────────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Set the redirect URI in the Spotify app settings to: http://127.0.0.1:8888/callback
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ── WireGuard (optional) ─────────────────────────────────────────────────────
# If set, start.sh will bring up this WireGuard interface before starting.
# Leave unset to skip WireGuard entirely.
# WG_INTERFACE=wg0

# ── Weather ───────────────────────────────────────────────────────────────────
# OpenWeatherMap API key — free tier is sufficient.
# https://openweathermap.org/api
PH3B3_OWM_KEY=your_openweathermap_api_key

# Default location for weather lookups. If unset, Ph3b3 will ask for
# a location rather than assuming. Format: "City,ST" or "City,Country"
PH3B3_DEFAULT_LOCATION=

# ── HTTPS / SSL (optional) ───────────────────────────────────────────────────
# Set both to enable HTTPS. Required for native mic access on mobile browsers
# (getUserMedia only works over HTTPS or localhost).
# Generate once with:
#   openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
#     -keyout ~/ph3b3_data/ssl/key.pem -out ~/ph3b3_data/ssl/cert.pem \
#     -subj "/CN=nyx" \
#     -addext "subjectAltName=DNS:localhost,IP:127.0.0.1,IP:192.168.x.x,IP:100.x.x.x"
# Browser will show a "not secure" warning on first visit — click Advanced → Proceed.
# ph3b3_data/ is in .gitignore — these files are never committed.
PH3B3_SSL_CERT=/home/youruser/ph3b3_data/ssl/cert.pem
PH3B3_SSL_KEY=/home/youruser/ph3b3_data/ssl/key.pem

# ── Stay offline ──────────────────────────────────────────────────────────────
# The sentence-transformers embedding model (memory) is cached on disk after
# first run, but the library revalidates it against huggingface.co at every boot.
# Those requests carry no user content — but the promise is that nothing leaves,
# and 29 outbound requests a boot is not nothing. Offline mode uses the local
# cache and never opens the socket. If a model is genuinely missing this fails
# loudly at startup instead of quietly downloading, which is the right way round.
# Comment these out for the FIRST run if you still need the model fetched.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
