[Unit]
Description=ComfyUI Image Generation Server
After=network.target

[Service]
Type=simple
# Replace "youruser" and the ComfyUI install path below to match your system.
User=youruser
WorkingDirectory=/home/youruser/comfyui
ExecStart=/home/youruser/comfyui/.venv/bin/python main.py --listen 127.0.0.1 --port 8188
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=comfyui

[Install]
WantedBy=multi-user.target
